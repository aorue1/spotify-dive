# Copy to .env and fill in. All are free and self-serve.
# The dashboard builds without them; they add genre, label, origin and recs.
export DISCOGS_TOKEN=          # discogs.com/settings/developers
export LASTFM_KEY=             # last.fm/api/account/create
export SPOTIFY_ID=             # developer.spotify.com/dashboard
export SPOTIFY_SECRET=
export CONTACT_EMAIL=          # MusicBrainz asks for a contact address

# --- optional ---
# Your Last.fm username, if you scrobble. Strongly recommended: Spotify's API
# only exposes your last 50 plays, so a long gap loses data permanently, while
# Last.fm keeps unlimited history and scrobbles from your phone too.
LASTFM_USER=

# Set to 1 to have the background jobs git-commit and push after each refresh.
# Leave off unless the clone points at a PRIVATE repo of your own — the built
# dashboard embeds your full listening history.
AUTO_PUSH=0

# Shared-device exclusion. Leave blank unless you find someone else's listening
# in your data (a cluster of out-of-character artists on one platform in one
# era). Turning it on deletes those plays from every chart.
EXCLUDE_PLATFORM=
EXCLUDE_PLATFORM_BEFORE=
